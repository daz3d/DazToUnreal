(function(){

	var oTransferTool = new DzTransferUtility();
	
    var aNodesToDelete = [];
    var oNewNameMapping = {};
    var oRfnToFigure = {};
    var oPrimarySelection = null;

    var aMorphProperties = [];
    var oMorphValues = {};    

    var aSafeNodes = [];

	var sShapePreserver = "ShapePreserver";
	var oShapePreserverCTRL = null;
	var oSceneHelper = new DzSceneHelper();

    var oCachedMeshTable = {};
    var oLoader = new DzMorphLoader();


	/*********************************************************************/
	// source: http://docs.daz3d.com/doku.php/public/software/dazstudio/4/referenceguide/scripting/api_reference/samples/modifiers/spawn_morph/start
	// Boolean : A function for testing whether or not a QObject instance
	// inherits one of a list of types
	function inheritsType( oObject, aTypeNames )
	{
		// If the object does not define the 'inherits' function
		if( !oObject || typeof( oObject.inherits ) != "function" ){
			// We are done... it is not a QObject
			return false;
		}
		
		// Iterate over the list of type names
		for( var i = 0, nTypes = aTypeNames.length; i < nTypes; i += 1 ){
			// If the object does not inherit the 'current' type
			if( !oObject.inherits( aTypeNames[i] ) ){
				// Next!!
				continue;
			}
			
			// Return the result
			return true;
		}
		
		// Return the result
		return false;
	};
	
	/*********************************************************************/
	// source: http://docs.daz3d.com/doku.php/public/software/dazstudio/4/referenceguide/scripting/api_reference/samples/modifiers/spawn_morph/start
	// DzNode : A function for getting the root of a node
	function getRootNode( oNode )
	{
		// If we have a node and it is a bone
		if( oNode && inheritsType( oNode, ["DzBone"] ) ){
			// We want the skeleton
			return oNode.getSkeleton();
		}
		
		// Return the original node
		return oNode;
	};


    function getWeights(oTarget, aReferenceVertexIndexList)
    {
        var oBoneMap = {};

        var oSkinBinding = oTarget.getSkinBinding();
        if (oSkinBinding==null) return;

        // get the bone bindings
        var numBoneBindings = oSkinBinding.getNumBoneBindings();
        for (var b=0; b<numBoneBindings; b++) {
            var oBoneBinding = oSkinBinding.getBoneBinding(b);
            if (oBoneBinding==null) continue;

            var oBoneNode = oBoneBinding.getBone();
            if (oBoneNode==null) continue;
            var sBoneName = oBoneNode.getName();

            // get the weight maps
            var oWeightMap = oBoneBinding.getWeights();
            if (oWeightMap==null) continue;

            var bNotEmpty = false;
            var aWeightArray = [];
            // get the weights for each reference vertex
            for (var i=0; i<aReferenceVertexIndexList.length; i++) {
                var nVertexIndex = aReferenceVertexIndexList[i];
                var fWeight = oWeightMap.getFloatWeight(nVertexIndex);
                if (fWeight > 0) {
                    bNotEmpty = true;
                }
                aWeightArray.push(fWeight);
            }
            if (bNotEmpty) {
                oBoneMap[sBoneName] = aWeightArray;
            }
        }

        return oBoneMap;
    }

    function getStrongestWeight(oBoneMapAvg)
    {
        var fStrongestWeight = 0;
        var sStrongestBoneName = "";
        for (var sBoneName in oBoneMapAvg) {
            var fWeight = oBoneMapAvg[sBoneName];
            if (fWeight > fStrongestWeight) {
                fStrongestWeight = fWeight;
                sStrongestBoneName = sBoneName;
            }
        }
        return sStrongestBoneName;
    }

    function copy_bone(oSourceBone, source, target) 
    {
        // if already exists, return
        if (target.getSkeleton().findNodeChild(oSourceBone.getName(), true)) {
//            print("Bone already exists: " + oSourceBone.getName());
            return;
        }

        var sParentBoneName = oSourceBone.getNodeParent().name;
        var oTargetParentBone = target.getSkeleton().findNodeChild(sParentBoneName, true);
        if (oTargetParentBone == null) {
            oTargetParentBone = copy_bone(oSourceBone.getNodeParent(), source, target);
            if (oTargetParentBone == null) {
                print("CRITCAL ERROR: bake_rfn: unable to create bone hierarchy for: " + oSourceBone.getName());
                return;
            }
        }
        
        // Create a new bone
        var oNewBone = new DzBone();
        Scene.addNode(oNewBone);
        
        // Set the name of the new bone
        oNewBone.setName(oSourceBone.name);
        oNewBone.setLabel(oSourceBone.getLabel());
        
        // Copy the origin, end point, and orientation from the source bone
        oNewBone.setOrigin(oSourceBone.getOrigin());
        oNewBone.setEndPoint(oSourceBone.getEndPoint());
        oNewBone.setOrientation(oSourceBone.getOrientation());
        
        // Add the new bone to the target figure's skeleton under the parent bone
        oTargetParentBone.addNodeChild(oNewBone);
                    
        // Refresh the scene to reflect changes
        Scene.update();
        
//        print("copy bone: success");
        
        return oNewBone;
    }

    function bake_rfn(oRfnNode)
    {
//        print("DEBUG: bake_rfn(): " + oRfnNode.name);
        if (oRfnNode.inherits("DzRigidFollowNode")==false) return;

        var oNodeParent = oRfnNode.getNodeParent();

        // get Follow Target (main mesh)
        var oRfnFollowTarget = oRfnNode.getFollowTarget();
        var oFollowTargetShape = oRfnFollowTarget.getObject().getCurrentShape();
        var oFollowTargetGeo = oFollowTargetShape.getGeometry();
        var oRfnSkeleton = oRfnNode.getSkeleton();

        // get Reference vertices and face (which serves as the mount point for
        // the static mesh that is parented to the Rigid Follow Node
        var group = oRfnNode.getGroup();
        if (group.inherits("DzRigidityGroup")==false) return;

        var referenceVertexIndexList = group.getReferenceVertexIndices();

        var oBoneMap = getWeights(oRfnFollowTarget, referenceVertexIndexList);

        // calculate average per bone in bonemap
        var oBoneMapAvg = {};
        for (var boneName in oBoneMap) {
            var weightArray = oBoneMap[boneName];
            var sum = 0;
            for (var i=0; i<weightArray.length; i++) {
                sum += weightArray[i];
            }
            var avg = sum / weightArray.length;
            oBoneMapAvg[boneName] = avg;
        }
//        print("DEBUG: oBoneMapAvg= " + JSON.stringify(oBoneMapAvg));

        var oBoneParent = null;
        if (oBoneParent==null) {
            var sStrongestBoneName = getStrongestWeight(oBoneMapAvg);
            oBoneParent = oRfnFollowTarget.findNodeChild(sStrongestBoneName, true);
        }
        if (oBoneParent==null) {
        	print("ERROR: bake_rfn: can't find oBoneParent.");
        	return;
        }
//        print("DEBUG: oBoneParent= " + oBoneParent.name + " for rfn: " + oRfnNode.name);

        // get child nodes of node
        var children = oRfnNode.getNodeChildren(true);
        for (var i=0; i < children.length; i++)
        {
            var oChildNode = children[i];
            var object = oChildNode.getObject()
            if (object==null) continue;
            var shape = object.getCurrentShape();
            if (shape==null) continue;
            var childGeo = shape.getGeometry();
            if (childGeo==null) continue;

			var oCachedMesh = oCachedMeshTable[oChildNode.name];

            var tempFile = exportNodeAsObj(oChildNode);
            var oNewStaticNode = importObj(tempFile);

            if (oNewStaticNode == null) {
                print("ERROR: bake_rfn: newNode is null");
                return;
            }
//            print("DEBUG: newNode = " + oNewStaticNode.name + ", moving to: " + oBoneParent.name);
            oBoneParent.addNodeChild(oNewStaticNode, true);
            var rootBoneName = oRfnSkeleton.getNodeChild(0).name;

			beginNodeSelectionHold();
			Scene.selectAllNodes( false );
			oNewStaticNode.select();
			// oShapePreserverCTRL.setValue( 0 );
			restoreNodeSelectionHold();

			
			var aNodesBefore = Scene.getNodeList();
            // oNewNameMapping[newFigure.name] = [oChildNode.name, oChildNode.getLabel()];
            // oRfnToFigure[oChildNode] = newFigure;
//            print("DEBUG: newFigure = " + newFigure.name + " (" + oChildNode.getLabel() + "), setting follow target to: " + oRfnFollowTarget.name);
			oTransferTool.setSource(oRfnFollowTarget);
			// oTransferTool.setTarget(newFigure);
			oTransferTool.setTarget(oNewStaticNode);
			oTransferTool.setParentToFigure(true);
			oTransferTool.setFitToFigure(true);

//			oTransferTool.setFitToFigure( true );
			oTransferTool.setTransferBinding( true );
			oTransferTool.setRemoveUnusedTargetBones( true );
//			oTransferTool.setParentToFigure( true );
			oTransferTool.setTransferFaceGroups( true );
			oTransferTool.setTransferSelectionMap( true );
			oTransferTool.setRemoveUnusedTargetBones( false );

			oTransferTool.doTransfer();
			var aNodesAfter = Scene.getNodeList();
			var newFigure = findNewNode( aNodesBefore, aNodesAfter );
			if (newFigure==null) {
				print("ERROR: bake_rfn: newFigure is null after TransferUtility");
				return;
			}
            oNewNameMapping[newFigure.name] = [oChildNode.name, oChildNode.getLabel()];
            oRfnToFigure[oChildNode] = newFigure;

            var skinBinding = newFigure.getSkinBinding();
            if (skinBinding == null) {
                print("ERROR: bake_rfn: Could not find skin binding for newFigure");
                return;
            }
            skinBinding.convertToGeneralMaps();
            skinBinding.removeAllBindings();

            // Function to find bone binding by bone name
            function findBoneBinding(skinBinding, boneName) {
                var numBoneBindings = skinBinding.getNumBoneBindings();
                for (var b=0; b<numBoneBindings; b++) {
                    var boneBinding = skinBinding.getBoneBinding(b);
                    if (boneBinding==null) continue;
                    var boneNode = boneBinding.getBone();
                    if (boneNode==null) continue;
                    if (boneNode.getName() == boneName) {
                        return boneBinding;
                    }
                }
                return null;
            }

            // Get the number of vertices in the newFigure
            var numVertices = newFigure.getObject().getCurrentShape().getGeometry().getNumVertices();

            skinBinding.beginEdit();
            skinBinding.setBindingMode(DzSkinBinding.General);
            skinBinding.setGeneralMapMode(DzSkinBinding.Linear);
            skinBinding.setScaleMode(DzSkinBinding.BindingMaps);
            skinBinding.setTargetVertexCount(numVertices);

            // For each bone in oBoneMapAvg, set the weight map
            for (var boneName in oBoneMapAvg) {

                // if bone doesn't exist in target, add it
                var boneNode = newFigure.getSkeleton().findNodeChild(boneName, true);
                if (boneNode==null) {
//                    print("Bone doesn't exist in target: " + boneName + ", creating...");
                    boneNode = copy_bone(oRfnFollowTarget.getSkeleton().findNodeChild(boneName, true), oRfnFollowTarget, newFigure);
                    if (boneNode==null) {
                        print("CRTICAL ERROR: bake_rfn: Unable to create bone: " + boneName + " for figure: " + newFigure.name);
                        return;
                    }
                }

                var boneWeight = oBoneMapAvg[boneName];

                var boneBinding = findBoneBinding(skinBinding, boneName);
//                var boneBinding = null;
                if (boneBinding == null) {
                    boneBinding = new DzBoneBinding();
                    boneBinding.setFigure(newFigure);
                    boneBinding.setBone(newFigure.findNodeChild(boneName, true));
                    result = skinBinding.addBoneBinding(boneBinding);
                    if (!result) {
                        print("CRITICAL ERROR: bake_rfn: Unable to add new bone binding to skin binding for: " + newFigure.name);
                        return;
                    }
//                    print("Creating new bonebinding for: " + boneName + ", boneBinding.label = " + boneBinding.getLabel());
                } else {
//                    print("Found bonebinding for: " + boneName + ", boneBinding.label = " + boneBinding.getLabel());
                }
                boneBinding.beginEdit();

                var weightMap = boneBinding.getWeights();
                if (weightMap==null) {
                    weightMap = new DzWeightMap();
                    boneBinding.setWeights(weightMap);
//                    print("Creating new weightmap for: " + boneName + ", weightMap.label = " + weightMap.getLabel());
                } else {
//                    print("Found weightmap for: " + boneName + ", weightMap.label = " + weightMap.getLabel());
                }
                weightMap.beginEdit();

//                weightMap.empty();
                if (weightMap.getNumWeights() != numVertices) {
//                    print("Setting numWeights for: " + boneName + " to " + numVertices);
                    weightMap.setNumWeights(numVertices);
                }
//                print("DEBUG: weightMap.label = " + weightMap.getLabel() + ", numWeights = " + weightMap.getNumWeights() );

                // Set the weight for all vertices
//                print("DEBUG: setting weight for bone: " + boneName + ", weight: " + boneWeight);
                for (var v=0; v<numVertices; v++) {
                    weightMap.setFloatWeight(v, boneWeight);
                }

                boneBinding.setWeights(weightMap);
                skinBinding.addBoneBinding(boneBinding);

                weightMap.finishEdit();
                boneBinding.finishEdit();

            }

            // 2025-05-20, DB: Compatibility fix for Rig Conversion deleting bones
            // Add empty weight maps (BoneBindings) for all ancestor bones
            for (var boneName in oBoneMapAvg) {
                var pBoneNode = newFigure.getSkeleton().findNodeChild(boneName, true);
                var pCurrentBoneNode = pBoneNode;
                while (pCurrentBoneNode != null) {
                    // get next parent bone
                    pCurrentBoneNode = pCurrentBoneNode.getNodeParent();
                    if (pCurrentBoneNode == null) break;
                    var pCurrentBoneName = pCurrentBoneNode.getName();
                    if (pCurrentBoneName in oBoneMapAvg) continue;
                    if (pCurrentBoneNode.inherits("DzBone")) {
                        // check if bone has bonebinding, if not, create it
                        var pCurrentBoneBinding = findBoneBinding(skinBinding, pCurrentBoneName);
                        if (pCurrentBoneBinding == null) {
                            pCurrentBoneBinding = new DzBoneBinding();
                            pCurrentBoneBinding.setFigure(newFigure);
                            pCurrentBoneBinding.setBone(pCurrentBoneNode);
                            result = skinBinding.addBoneBinding(pCurrentBoneBinding);
                            if (!result) {
                                print("CRITICAL ERROR: Unable to add new bone binding to skin binding for: " + newFigure.name);
                                return;
                            }
//                            print("Creating empty bonebinding for: " + pCurrentBoneName + ", boneBinding.label = " + pCurrentBoneBinding.getLabel());
                            pCurrentBoneBinding.beginEdit();
                            var pCurrentWeightMap = new DzWeightMap();
                            pCurrentBoneBinding.setWeights(pCurrentWeightMap);
//                            print("Creating empty weightmap for: " + pCurrentBoneName + ", weightMap.label = " + pCurrentWeightMap.getLabel());
                            pCurrentWeightMap.beginEdit();
                            if (pCurrentWeightMap.getNumWeights() != numVertices) {
//                                print("Setting numWeights for: " + pCurrentBoneName + " to " + numVertices);
                                pCurrentWeightMap.setNumWeights(numVertices);
                            }
                            pCurrentWeightMap.finishEdit();
                            pCurrentBoneBinding.finishEdit();
                        }
                    }
                }
            }

            // Ensure that other bones have zero weights
            var numBoneBindings = skinBinding.getNumBoneBindings();
            for (var b=0; b<numBoneBindings; b++) {
                var boneBinding = skinBinding.getBoneBinding(b);
                if (boneBinding==null) continue;
                var boneNode = boneBinding.getBone();
                if (boneNode==null) continue;
                var boneName = boneNode.getName();

                if (!(boneName in oBoneMapAvg)) {
                    // Set weights to zero
                    var weightMap = boneBinding.getWeights();
                    if (weightMap==null) continue;
                    weightMap.beginEdit();
                    for (var v=0; v<numVertices; v++) {
                        weightMap.setFloatWeight(v, 0.0);
                    }
                    weightMap.finishEdit();
                }
            }
            aNodesToDelete.push(oChildNode);

            skinBinding.finishEdit();

            oCachedMeshTable[newFigure.name] = oCachedMesh;

			// oShapePreserverCTRL.setValue( 1 );

			// // Finalize
			// Scene.update();
			// oRfnFollowTarget.update();
			// oRfnFollowTarget.finalize();
			
			// beginNodeSelectionHold();
			// Scene.selectAllNodes( false );
			// newFigure.select();

			// newFigure.update();
			// newFigure.finalize();
			// processEvents();
			// while( backgroundProgressIsActive() ) {
			// 	processEvents();
			// }
			// sleep( 1000 );

			// var oLoader = new DzMorphLoader();
			// var sMorphName = newFigure.name + "_morph";
			// oLoader.setMorphName( sMorphName );
			// oLoader.setReverseDeformations( true );
			// oLoader.setOverwriteExisting( DzMorphLoader.DeltasOnly );
			// oLoader.setCleanUpOrphans( true );
			// oLoader.setPropertyGroupPath( "Morphs/Morph Loader" );
			// oLoader.createMorphFromMesh( oCachedMesh, newFigure );

			// restoreNodeSelectionHold();

			// var oMorph = oSceneHelper.findPropertyOnNodeByInternalName( sMorphName, newFigure );
			// if( oMorph && oMorph.getValue() != 1 ){
			// 	oMorph.setValue( 1 );
			// }
        }        

        aNodesToDelete.push(oRfnNode);
    }

    function correctPosition(oNewNode, oOldNode)
    {
        oNewNode.finalize();
        oOldNode.finalize();

        var oOldGeo = oOldNode.getObject().getCachedGeom();
        var oNewObj = oNewNode.getObject();
        var oNewCachedGeo = oNewObj.getCachedGeom();
        if (oNewCachedGeo==null) {
//            print("ERROR: newCached is null, trying to force update...");
            oNewObj.forceCacheUpdate(oNewNode, true);
            oNewCachedGeo = oNewObj.getCachedGeom();
            if (oNewCachedGeo==null) {
                print("ERROR: bake_rfn: newCached is still null, skipping...");
                return;
            }
            
        }
        var oNewGeo = oNewObj.getCurrentShape().getGeometry();

        oNewGeo.beginEdit();
        for (var i=0; i<oOldGeo.getNumVertices(); i++) {
            var oldVertex = oOldGeo.getVertex(i);
            if (oNewCachedGeo) {
                var newCachedVertex = oNewCachedGeo.getVertex(i);
            } else {
                var newCachedVertex = null;
            }
            var newVertex = oNewGeo.getVertex(i);
            // offset
            var offset = oldVertex.subtract(newVertex);
            newVertex = newVertex.add(offset);
            oNewGeo.setVertex(i, newVertex);
        }
        oNewGeo.finishEdit();

        oNewNode.finalize();
        oOldNode.finalize();
        oNewNode.getObject().forceCacheUpdate(oNewNode, true);
        oOldNode.getObject().forceCacheUpdate(oOldNode, true);
        oOldGeo = oOldNode.getObject().getCachedGeom();
        oNewGeo = oNewNode.getObject().getCachedGeom();
        // Double Check
        for (var i=0; i<oOldGeo.getNumVertices(); i++) {
            var oldVertex = oOldGeo.getVertex(i);
            var newVertex = oNewGeo.getVertex(i);
            var offset = oldVertex.subtract(newVertex);
        }

    }

	function findUnselectedNode()
	{
		var oNewNode = null;
		for (var i=0; i < Scene.getNumNodes(); i++)
		{
			var node = Scene.getNode(i);
			if (node.isSelected() == false) oNewNode = node;
			node.select(!node.isSelected());
		}
		return oNewNode;
	}

    function importObj(sObjFilename)
    {
//        print("DEBUG: importing obj: " + sObjFilename);
        Scene.selectAllNodes(true);
        var oImportOptions = new DzFileIOSettings();
        oImportOptions.setFloatValue("Scale", 100.0);
        oImportOptions.setIntValue("RunSilent", 1);
        var oObjImporter = new DzObjImporter();
        oObjImporter.readFile(sObjFilename, oImportOptions);

        // reverse selection
        var oNewNode = findUnselectedNode();
        oObjImporter.deleteLater();
        return oNewNode;
    }

	function exportNodeAsObj(oNode)
	{
//        print("DEBUG: exporting obj: " + oNode.name);
        Scene.selectAllNodes(false);
        oNode.select(true);
        // export
        var exportOptions = new DzFileIOSettings();
        exportOptions.setFloatValue("Scale", 100.0);
        exportOptions.setBoolValue("IgnoreInvisible", true);
        exportOptions.setBoolValue("WriteG", true);
        exportOptions.setBoolValue("GroupGeom", true);
        exportOptions.setBoolValue("GroupSingle", false);
        exportOptions.setBoolValue("WriteMtllib", true);
        exportOptions.setBoolValue("WriteUsemtl", true);
        exportOptions.setBoolValue("SelectedOnly", true);
        exportOptions.setIntValue("RunSilent", 1);

        var sTempObjFilename = App.getTempFilename() +  "_" + oNode.name + ".obj";
        oExporter = new DzObjExporter();
        oExporter.writeFile(sTempObjFilename, exportOptions);
        oExporter.deleteLater();

        return sTempObjFilename;
	}

    // Function to process properties
    function processProperty(oProperty, oNode) {
        var propName = oProperty.getName();
        var propLabel = oProperty.getLabel();
        var oPresentation = oProperty.getPresentation();

        if (oPresentation) {
            var morphInfo = {
                Name: propName,
                Label: propLabel,
                Path: oNode.getLabel() + "/" + oProperty.getPath(),
                Type: oPresentation.type,
                Property: oProperty,
                Node: oNode
            };

            if (String(oPresentation.type).find("Shape")==-1) {
                return;
            }

            // Store the original value of the morph property
            if (oProperty.inherits("DzFloatProperty")) {
                var originalValue = oProperty.getRawValue();
            } else if (oProperty.inherits("DzNumericProperty")) {
                print("WARNING: double property: " + propName);
                var originalValue = oProperty.getDoubleValue();
            }
            if (originalValue === 0) return;

            var nIndex = aMorphProperties.length;
            // Use property path as key to ensure uniqueness
            oMorphValues[morphInfo.Path] = originalValue;
//            print("DEBUG: ZEROING " + " [" + nIndex + "] " + morphInfo.Path + " , [" + propName + "] ==> 0 , type: " + oPresentation.type);

            // Set the morph property value to zero
            if (oProperty.inherits("DzFloatProperty"))
            {
                oProperty.setValue(0.0);
            }
            else if (oProperty.inherits("DzNumericProperty")) 
            {
                oProperty.setDoubleValue(0.0);
            }

            // Store the property for later restoration
            aMorphProperties.push(oProperty);
        }
    }

    function resetMorphs(oNode) {

        // Get the object and shape from the node
        var oObject = oNode.getObject();
    
        // Process node properties
//        print("DEBUG: Processing node properties...");
        var numNodeProperties = oNode.getNumProperties();
        for (var i = 0; i < numNodeProperties; i++) {
            var oProperty = oNode.getProperty(i);
            processProperty(oProperty, oNode);
        }
    
//        print("DEBUG: Processing object modifiers...");
        // Process object modifiers
        if (oObject) {
            var numModifiers = oObject.getNumModifiers();
            for (var i = 0; i < numModifiers; i++) {
                var oModifier = oObject.getModifier(i);
                var modName = oModifier.getName();
                var modLabel = oModifier.getLabel();
    
                // Check if the modifier is a DzMorph
                if (oModifier.inherits("DzMorph")) {
                    // Process properties of the modifier
                    var numModifierProperties = oModifier.getNumProperties();
                    for (var j = 0; j < numModifierProperties; j++) {
                        var oProperty = oModifier.getProperty(j);
                        processProperty(oProperty, oNode);
                    }
                }
            }
        }
    
    }


	/******************************************************************/
	// DzNode : A function to find the newest node
	function findNewNode( aNodesBefore, aNodesAfter ){
		// Creates a cache of existing node IDs for efficient lookup.
		var oNodeCache = {};
		for( var i = 0; i < aNodesBefore.length; i++ ){
			var node = aNodesBefore[i];
			try {
				// Attempt to access a property to check if the object is still valid.
				// If it's a deleted QObject, this line will throw an error.
				oNodeCache[ node.elementID ] = true;
			} catch(e) {
				// If an error occurs (e.g., deleted QObject), skip this node.
				// Log a warning for debugging purposes.
				//print( "##FR## " + "Warning: Skipped node in aNodesBefore cache due to error: " + e );
				continue;
			}
		}
		
		// Iterates through the nodes after the asset load to find new one
		var aNewNodes = [];
		for( var i = 0; i < aNodesAfter.length; i++ ){
			var oNode = getRootNode( aNodesAfter[ i ] );
			if( !oNodeCache[ oNode.elementID ] ){
				return oNode;
			}
		}
		return;
	};

	/*********************************************************************/
	// Boolean : A function to check if a node's parent is a DzRigidFollowNode
	function isChildOfDzRigidFollowNode( oNode ){
		var oParent = oNode.getNodeParent();
		if( oParent && oParent.inherits( "DzRigidFollowNode" ) ){
			return true;
		}
		return false;
	};

	/*********************************************************************/
	// Function to find the highest DzRigidFollowNode ancestor in the hierarchy
	function reparentToNearestRFNAncestor( oNode ){
		var oCurrentParent = oNode.getNodeParent(); // Start with the immediate parent

		// Traverse up the hierarchy
		while( oCurrentParent ){
			if( oCurrentParent.inherits( "DzRigidFollowNode" ) ){
				// Found the nearest DzRigidFollowNode ancestor
				// Reparent the original node to this ancestor
				oCurrentParent.addNodeChild( oNode, true );
				oNode.update();
				oNode.finalize();

				print( oNode.getLabel(), "parented to", oCurrentParent.getLabel() );

				return oCurrentParent; // Return the ancestor node that oNode was reparented to
			}
			oCurrentParent = oCurrentParent.getNodeParent(); // Move to the next parent
		}
		return null; // No DzRigidFollowNode ancestor found in the hierarchy
	};

    function main()
    {
        // get RigidFollowNode
        oPrimarySelection = Scene.getPrimarySelection();

		var aRootNodes = getSceneRootNodesList();
		// oShapePreserverCTRL = createControlProperty( oPrimarySelection, sShapePreserver, aRootNodes );
		// if( !oShapePreserverCTRL ){
		// 	print( "##FR## " + "Error creating ShapePreserver for", oPrimarySelection.getLabel() );
		// 	print( "##FR## " + "Script finished." );
		// 	return;
		// }
		// // Pre-process all nodes to update morphs if they have smoothing modifiers
		// for( var i = 0; i < aRootNodes.length; i++ ){
		// 	var oNode = aRootNodes[ i ];
		// 	// Skip oRootFigure for the morph baking, as it's handled differently or doesn't need this specific pre-processing
		// 	if( oNode !== oPrimarySelection ){
		// 		updateMorphsOnNode( oNode );
		// 	}
		// }

        Scene.update();
        oPrimarySelection.finalize();
        if (oPrimarySelection.getObject()) {
            oPrimarySelection.getObject().forceCacheUpdate(oPrimarySelection, true);
        }
    
        var children = oPrimarySelection.getNodeChildren(true);
        for (var i=0; i < children.length; i++)
		{
			var child = children[i];
			if (child.getObject() && isChildOfDzRigidFollowNode( child ) ){
				reparentToNearestRFNAncestor( child );
			}
		}

        oPrimarySelection.getYRotControl().setValue(0.0);
        Scene.update();
        oPrimarySelection.finalize();
        // cache geometry
		for (var i=0; i < children.length; i++)
		{
			var child = children[i];
			if (child.getObject() && isChildOfDzRigidFollowNode( child ) ){
                var object = child.getObject()
                if (object==null) continue;
                var shape = object.getCurrentShape();
                if (shape==null) continue;
                var childGeo = shape.getGeometry();
                if (childGeo==null) continue;

                var oCachedMesh = object.getCachedGeom();
                oCachedMeshTable[child.name] = oCachedMesh;
			}
		}

        resetMorphs(oPrimarySelection);
		var oScaleControl = oPrimarySelection.getScaleControl();
		oScaleControl.setRawValue(1.0);
		var correction = oScaleControl.getValue();
		oScaleControl.setValue(1/correction);
		oPrimarySelection.getYRotControl().setValue(0.0);


        // var children = oPrimarySelection.getNodeChildren(true);
        for (var i=0; i < children.length; i++)
        {
            var child = children[i];
            if (child.inherits("DzRigidFollowNode"))
            {
                bake_rfn(child);
            }
        }

        for (var i=0; i < aNodesToDelete.length; i++)
        {
            var deleteMe = aNodesToDelete[i];
            if (deleteMe in oRfnToFigure) {
                if (deleteMe.inherits("DzRigidFollowNode")) continue;
                if (deleteMe.getObject()==null) continue;
                var newFigure = oRfnToFigure[deleteMe];
                if (newFigure) {
//                    print("DEBUG: rfnToFigure: " + deleteMe.name + " -> " + newFigure.name);
                    // correctPosition(newFigure, deleteMe);
                }
            }
            
        }

        // delete nodes
        for (var i=0; i < aNodesToDelete.length; i++)
        {
            var deleteMe = aNodesToDelete[i];
            nodeParent = deleteMe.getNodeParent();
            if (aSafeNodes.indexOf(deleteMe) >= 0) {
                continue; // skip safe nodes
            }
            while (deleteMe.getNodeChildren().length > 0)
            {
                var child = deleteMe.getNodeChild(0);
                if (child) {
                    deleteMe.removeNodeChild(child, true);
                    if (deleteMe in oRfnToFigure) {
                        var newFigure = oRfnToFigure[deleteMe];
                        if (newFigure) {
                            newFigure.addNodeChild(child, true);
                        } else if (nodeParent) nodeParent.addNodeChild(child, true);
                    } else if (nodeParent) nodeParent.addNodeChild(child, true);    
                }
            }
            if (nodeParent) nodeParent.removeNodeChild(deleteMe, true);
            Scene.removeNode(deleteMe);
        }

//    	print("DEBUG: renaming new figures...");
        for (var newFigureName in oNewNameMapping) {
        	var newFigure = Scene.findNode(newFigureName);
        	if (newFigure==null) {
        		print("can't find node: " + newFigureName);
        	}
        	print("DEBUG: newFigure=" + newFigure + ", name=" + newFigure.name + ", class= " + newFigure.className() );
            var name = oNewNameMapping[newFigureName][0];
            var label = oNewNameMapping[newFigureName][1]
            print("DEBUG: renaming to " + name + ", label = " + label);
            newFigure.setLabel(label);
            newFigure.setName(name);
        }

        // Restore the morph properties to their original values
        for (var i = 0; i < aMorphProperties.length; i++) {
            var oProperty = aMorphProperties[i];
            var sPath = oPrimarySelection.getLabel() + "/" + oProperty.getPath();
            var propName = oProperty.getName();

            // Restore the original value
//            print("DEBUG: RESTORING " + " [" + i + "] " + sPath + " , [" + propName + "] => " + oMorphValues[sPath]);
            oProperty.setDoubleValue(oMorphValues[sPath]);
        }

        // Morph Correction
        var children = oPrimarySelection.getNodeChildren(true);
        for (var i=0; i < children.length; i++)
        {
            var child = children[i];
            if (child.getObject()==null) continue;
            if (! (child.name in oCachedMeshTable) ) continue;
            var oCachedMesh = oCachedMeshTable[child.name];
            if (!oCachedMesh) continue;
            print("DEBUG: Applying corrective morph  to " + child.name);
            var sMorphName = child.name + "_morph_correction";
            oLoader.setMorphName( sMorphName );
            oLoader.setReverseDeformations( true );
            oLoader.setOverwriteExisting( DzMorphLoader.DeltasOnly );
            oLoader.setCleanUpOrphans( true );
            oLoader.setPropertyGroupPath( "Morphs/Morph Loader" );
            oLoader.createMorphFromMesh( oCachedMesh, child );

            // var oMorph = oSceneHelper.findPropertyOnNodeByInternalName( sMorphName, child );
            // if( oMorph && oMorph.getValue() != 1 ){
            //     oMorph.setValue( 1 );
            // }
        }

        // restore selection
        Scene.selectAllNodes(false);
        Scene.setPrimarySelection(oPrimarySelection);

        MessageBox.information("Rigid Follow Nodes have been converted to DzFigure followers.", "Script Completed", "OK");
    }

	/*********************************************************************/
	// DzProperty : A function to create a property, ERC Freeze current state to it
	function createControlProperty( oRootNode, sName, aNodes )
	{
		// Check for property before creating
		var oControllerProperty = oSceneHelper.findPropertyOnNodeByInternalName( sName, oRootNode );
		if( oControllerProperty ){
			return oControllerProperty;
		}

		// Declare a property group path
		var sPropertyGroup = "Morphs/Morph Loader";
	
		// Create and setup a controller property
		var oControllerProperty = new DzFloatProperty( sName, true, true );
		//oControllerProperty.setLabel( "ERC Freeze Controller" );
		oControllerProperty.setPath( sPropertyGroup );
		oControllerProperty.setMinMax( 0, 1 );
		oControllerProperty.setIsClamped( true );
		oRootNode.addProperty( oControllerProperty );

		// Create the ERC Freeze utility
		var oFreezer = new DzERCFreeze();
		
		// Set the controller node
		oFreezer.setControllerNode( oRootNode );
		// Set the controller property
		oFreezer.setControllerProperty( oControllerProperty );
		
		beginNodeSelectionHold();
		Scene.selectAllNodes( false );

		// Add all nodes
		var oNode;
		for( var i = 0; i < aNodes.length; i++ ){
			oNode = aNodes[ i ];
			if( !oNode ){
				continue;
			}
			
			if( oNode !== oRootNode && oNode.inherits( "DzSkeleton") && !oNode.getFollowTarget() ){
				oNode.select( true );

				print( "Memorizing Rigging on", oNode.getLabel() );

				// Memorize Figure Rigging
				triggerAction( "DzJEMemorizeFigureRiggingPropertiesAction", false, null );
				
				oNode.select( false );
			}
			
			// Add the node's properties
			print( "Adding Freeze Properties", oFreezer.addPropertiesToFreeze( oNode ) );
		}

		restoreNodeSelectionHold();
	
		// We're not using animated links
		oFreezer.setKeyed( false );
		
		// Restore the figure when the freeze is complete
		oFreezer.setRestoreFigure( true );
		// Restore the rigging when the freeze is complete
		oFreezer.setRestoreRigging( true );
		// Apply the controller property when the freeze is complete
		oFreezer.setApplyController( true );
		// Don't restore selected item
		oFreezer.setRestoreSelectedItems( false );
	
		// Begin collecting undo-able operations
		UndoStack.beginHold();
		// If the freeze is successful
		if( oFreezer.doFreeze() ){
			// Create the undo item
			UndoStack.accept( "ERC Freeze" );

			// Find Property
			var oProperty = oSceneHelper.findPropertyOnNodeByInternalName( sName, oRootNode );
			if( !oProperty ){
				// Cancel the undo item
				UndoStack.cancel();
				return null;
			}
			return oProperty;
		// If the freeze fails
		} else {
			// Cancel the undo item
			UndoStack.cancel();
			return null;
		}

	};

	/*********************************************************************/
	// Optimized: Uses a plain object as a hash map for faster existence checks
	function getSceneRootNodesList(){
		var aTemp = [];
		var aDelete = []; // Objects that need to be removed, such as geometry shells
		var aNodeList = Scene.getNodeList();
		var oNode, oShape, oLODProperty;
		for( var i = 0; i < aNodeList.length; i++ ){
			oNode = Scene.getNode( i );
			// Skip non-objects
			if( !oNode.getObject() ){
				continue;
			}
			// Skip bones
			if( oNode.inherits( "DzBone" ) ){
				continue;
			}
			// Skip geometry shells if outline
			if( oNode.inherits( "DzGeometryShellNode" ) && oNode.getLabel().endsWith( " Outline" ) ){
				aDelete.push( oNode );
				continue;
			}
			
			// Disable SubD
			oShape = oNode.getObject().getCurrentShape();
			if( oShape ){
				// If subdivision is active
				if( oShape.isSubDivisionActive() ){
					// Get the 'Resolution Level' property
					oLODProperty = oShape.getLODControl();
					// Set the value to 'Base'
					oLODProperty.setValueFromString( "Base" );
				}
			}

			// Enable realtime smoothing
			/*oObject = getObjectForNode( oNode, true );
			if( oObject ){
				oSmoother = oObject.findModifier( "DzMeshSmoothModifier" );
				if( oSmoother ){
					oSmoothProperty = oSmoother.getInteractiveUpdateControl();
					if( oSmoothProperty ){
						oSmoothProperty.setBoolValue( true );
					}
				}
			}*/
			
			aTemp.push( oNode );
		}

		// Delete
		for( var i = aDelete.length - 1; i >= 0; i-- ){
			Scene.removeNode( aDelete[ i ] );
		}

		return aTemp;
	};

	/*********************************************************************/
	// String : A function for triggering an action
	function triggerAction( sClassName, bGetDefaultOptions, oSettings )
	{
		// Get the action manager
		var oActionMgr = MainWindow.getActionMgr();
		// If we do not have an action manager
		if( !oActionMgr ){
			// We are done...
			return;
		}
		
		// Find the action we want
		var oAction = oActionMgr.findAction( sClassName );
		// If the action was not found
		if( !oAction ){
			// Inform the user...
			showAlert(
				text( "The \"%1\" action could not be found." ).arg( sClassName ),
				text( "Resource Error" ), text( "&OK" ), "warning" );
			// We are done...
			return;
		}
		
		// If the action is disabled
		if( !oAction.enabled ){
			// Inform the user...
			showAlert(
				text( "The \"%1\" action is currently disabled." ).arg( oAction.text ),
				text( "Resource Error" ), text( "&OK" ), "warning" );
			// We are done...
			return;
		}

		// Print default options
		if( bGetDefaultOptions ){
			var oDefaultSettings = oAction.defaultSettings;

			print( "----- Default Settings -----" );
			
			print( JSON.stringify( oAction.defaultSettings, null, "\t" ) );
			
			print( "----------------------------" );
			
			return;
		}
		
		// If we have the necessary function (4.16.1.18) and we have settings
		if( typeof( oAction.triggerWithSettings ) == "function" && oSettings ){
			// Trigger execution of the action with the settings
			oAction.triggerWithSettings( oSettings );
		} else {
			// Trigger execution of the action
			oAction.trigger();
		}
	};

	/*********************************************************************/
	// void : A function to bake current state of item to morph
	function updateMorphsOnNode( oNode )
	{
		// Enable Interactive Update on smoothing modifier
		var oObject = oNode.getObject();
		if( !oObject ){
			print( "##FR## " + "Unable to get object of node " + oNode.getLabel() );
			return;
		}
		var oSmoother = oObject.findModifier( "DzMeshSmoothModifier" );
		if( !oSmoother ){
			// print( "Smoothing not enabled, skipping node " + oNode.getLabel() );
			return;
		}
		var oSmoothEnable = oSmoother.getEnableSmoothingControl();
		if( !oSmoothEnable ){
			print( "##FR## " + "Unable to get Smoothing Enable property on node " + oNode.getLabel() );
			return;
		}
		var oSmoothInteractiveEnable = oSmoother.getInteractiveUpdateControl();
		if( !oSmoothInteractiveEnable ){
			print( "##FR## " + "Unable to get Interactive Update property on node " + oNode.getLabel() );
			return;
		}

		// Skip if smoothing not enabled
		if( !oSmoothEnable.getBoolValue() ){
			// print( "Smoothing not enabled, skipping node " + oNode.getLabel() );
			return;
		}

		print( "Updating morphs on : " + oNode.name );

		// Set interactive update
		oSmoothInteractiveEnable.setBoolValue( true );

		oNode.update();
		oNode.finalize();
		processEvents();
		while( backgroundProgressIsActive() ){
			processEvents();
		}
		sleep( 1000 );

		// Retrieve duplicated mesh from map
		var oNodeCopy = g_oDuplicatedNodesMap[ oNode.elementID ];
		if( !oNodeCopy ){
			print( "##FR## " + "Error: Duplicated mesh not found for " + oNode.getLabel() );
			return;
		}
		oNodeCopy.setVisible( true ); // Make the duplicated node visible

		// Bake current mesh state to new morph and set active
		// Store current mesh
		var oCurrentMesh = getFacetMeshForNode( oNodeCopy, true, false );
		if( !oCurrentMesh ){
			print( "##FR## " + "Error getting cached mesh for", oNode.getLabel() );
			Scene.removeNode( oNodeCopy );
			return;
		}

		print( "Baking morph for " + oNode.getLabel() );

		// Disable smoothing
		oSmoothEnable.setBoolValue( false );

		// Remove all unknown modifiers
		var nModifiers = oObject.getNumModifiers();
		var aKnownModifiers = [ "DzMorph", "DzSkinBinding", "DzBoneBinding" ];
		for( var i = nModifiers - 1; i >= 0; i-- ){
			var oModifier = oObject.getModifier( i );
			if( aKnownModifiers.indexOf( oModifier.className() ) > -1 ){
				continue;
			}
			print( "##FR## " + oModifier.className() + " found. Removing" );
			oObject.removeModifier( oModifier );
		}

		// Disable DzGeometrySculptModifier
		// var oGeometrySculptModifier = oObject.findModifier( "DzGeometrySculptModifier" );
		// if( oGeometrySculptModifier ){
		// 	oObject.removeModifier( oGeometrySculptModifier );
		// }

		oNode.update();
		oNode.finalize();
		processEvents();
		while( backgroundProgressIsActive() ){
			processEvents();
		}
		sleep( 1000 );

		// Load oCurrentMesh as morph
		// Create a morph loader instance
		oLoader = new DzMorphLoader();
		var sMorphName = sShapePreserver + "_Morph";
		// Configure morph loader
		oLoader.setMorphName( sMorphName );
		oLoader.setReverseDeformations( true );
		oLoader.setOverwriteExisting( DzMorphLoader.DeltasOnly );
		oLoader.setCleanUpOrphans( true );
		oLoader.setPropertyGroupPath( "Morphs/Morph Loader" );
		
		// Create the morph and capture the log - 4.15.0.6+
		var sLog = oLoader.createMorphFromMesh( oCurrentMesh, oNode );
		// If the log is not empty
		if( !sLog.isEmpty() ){
			// Provide feedback
			print( "##FR## " + "Morph Loader:", sLog );
		}

		// Find and activate morph (if has no value)
		var oMorph = oSceneHelper.findPropertyOnNodeByInternalName( sMorphName, oNode );
		if( oMorph && oMorph.getValue() != 1 ){
			oMorph.setValue( 1 );
		}

		Scene.removeNode( oNodeCopy );
	};



    main();
})();
