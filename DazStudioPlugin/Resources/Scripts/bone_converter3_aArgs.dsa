// DAZ Studio version 4.21.0.5 filetype DAZ Script

// Script: bone_converter.dsa
// Description: This script converts a Genesis 8 or 9 skeleton to be compatible with a custom rig.
// It iterates through all bones within a selected figure hierarchy, renames them according to a mapping,
// and deletes any unmapped bones.  Weights from deleted bones are redistributed to the parent bone by
// Daz Studio.
// Usage: Select a Genesis 8 or 9 figure in DAZ Studio before running this script.

// bone_converter Version 2: ignore unmapped nodes, only explicitly delete nodes; if there is unmapped node collistion, rename original to "_original"
// bone_converter Version 2.1: added debug output for ignored bones
// bone_converter Version 2.2: proceed anyway if more numkeys than matching keys
// bone_converter Version 3: add new bones support via "++" and "&" syntax in mapping table, ">>" to indicate parent-child relationship

(function( aArgs ){

var aBoneMapFiles = [];
var includeDir_oFILE = new DzFile( getScriptFileName() );
var sIncludePath = includeDir_oFILE.path();   

var aRenamedBones = [];
var aBonesToDelete = [];

var oBonesToAddMapping = {};
var aBonesAdded = [];

function processArguments() {
    print("processArguments(): Sanity Checking...");
//    print("DEBUG: aArgs= " + aArgs + ", aArgs.length= " + aArgs.length);
    if (!aArgs || Array.isArray(aArgs) == false || aArgs.length == 0) {
        return false;
    }
    for( var i = 0, nArgs = aArgs.length; i < nArgs; i += 1 ){
        // add each arg to bonemap files
        aBoneMapFiles.push(aArgs[i]);
    }
    return true;
}

function recursiveTraverseNodes(node) {
    var aBoneList = [];

    var children = node.getNodeChildren();
    for (var i = 0; i < children.length; i++) {
        recursiveList = recursiveTraverseNodes(children[i]);
        aBoneList = aBoneList.concat(recursiveList);
    }
    var dzObject = new DzObject();
    dzObject = node;
    if (dzObject && dzObject.inherits("DzBone")) {
//    	print("DEBUG: adding bone to bonelist: " + dzObject.name)
        aBoneList.push(dzObject);
    }

//	print("DEBUG: bonelist.length= " + aBoneList.length);
    return aBoneList;
}

// Retrieves all bones of the selected figure.
function getBones(figure) {
    var aBoneList = recursiveTraverseNodes(figure);
    // print("DEBUG: bonelist.length= " + aBoneList.length);
    return aBoneList;
}

// Renames bones in the selected figure according to the mapping.
function renameBones(figure, mapping) {
    var aBoneList = getBones(figure); // Assuming getBones() retrieves all bones of the figure

    // only mark bones for deletion if they are not on either side of the mapping table
    var aSafeList = [];
    // for (var key in mapping) {
    //     var val = mapping[key];
    //     print("DEBUG: pushing safe bone: " + val)
    //     aSafeList.push(val);
    // }

    // create lookup table for original bone names
    var aOriginalBoneNames = [];
    for (var i = 0; i < aBoneList.length; i++)
    {
        aOriginalBoneNames.push(aBoneList[i].name);
    }

    for (var i = 0; i < aBoneList.length; i++) 
    {
        var bone = aBoneList[i];
        // print("DEBUG: processing bone: " + bone.name);
        var key = bone.name;
        if (mapping.hasOwnProperty(key)) {
            var value = mapping[key];
            if (value == key) {
                continue;
            }
            if (typeof(value) == "string")
            {
                // check if existing original bone with name==value
                if (arrayContainsValue(aOriginalBoneNames, value)) {
                    // rename original bone
                    original_bone_index = aOriginalBoneNames.indexOf(value);
                    original_bone = aBoneList[original_bone_index];
                    original_bone_new_name = value + "__original";
                    // print("DEBUG: renaming original bone to " + original_bone_new_name);
                    original_bone.setName(original_bone_new_name);
                    original_bone.setLabel(original_bone_new_name);
                }
                // print("DEBUG: renaming bone: " + key + " to " + value);
                bone.setName(value);
                bone.setLabel(value);
                aRenamedBones.push(bone);
            }
            else if (typeof(value) == "number") {
                if (value == -1) {
                    // print("DEBUG: marking bone for deletion: " + key);
                    aBonesToDelete.push(bone);
                }
            }
        }
        // else if (!arrayContainsValue(aSafeList, key)) {
        //     print("DEBUG: marking bone for deletion: " + key);
        //     aBonesToDelete.push(bone);
        // }
        else {
            print("DEBUG: bone not in mapping, ignoring: " + key);
        }
    }
}

function arrayContainsValue(array, value) {
	for (var i=0; i < array.length; i++) {
		if (array[i] == value) {
			return true;
		}
	}
	return false;
}

function deleteBone(node) {
    var dzobject = new DzObject();
    dzobject = node;
    if (dzobject.inherits("DzBone")) {
        // select none
        Scene.selectAllNodes(false);
        // select node to delete
        Scene.setPrimarySelection(node);
        // double check that this is really DzBone node
        dbl_check = Scene.getSelectedNode(0);
        if (dbl_check == node)
        {
            print("deleting bone: " + node.name);
            obj = DzJEDeleteBoneAction();
            obj.executeAction();
        }
    }
}

// NOTE: as of version 2, this does not delete unmapped bones, only those explicitly mapped to -1
// Deletes bones not present in the mapping from the selected figure.
function deleteMarkedBones() {
    for (var i = 0; i < aBonesToDelete.length; i++) {
        var bone = aBonesToDelete[i];
        // final sanity check
        if (!arrayContainsValue(aRenamedBones, bone)) {
            // print("DEBUG: deleting bone: " + bone.name);
            deleteBone(bone);
        }
    }
}

// Adds new bones into bone tree based on oBonesToAddMapping
function addNewBones(figure) {
    var aBoneList = getBones(figure); // Assuming getBones() retrieves all bones of the figure
    var bone_exists = false;
    var add_bone_expression = null;
    var expression_01 = null;
    var parent_bone_name = null;
    // child bones used in averaging position
    var child_bone_names = [];
    var parent_bone = null;
    var child_bones = [];
    // additional child bones to reparent to new bone without affecting position
    var additional_child_bone_names = [];
    var additional_child_bones = [];
    var bone = null;
    var new_bone = null;

    for (var new_bone_name in oBonesToAddMapping) {
        if (oBonesToAddMapping.hasOwnProperty(new_bone_name)) {
            add_bone_expression = oBonesToAddMapping[new_bone_name];
            expression_01 = add_bone_expression.split(">>")[0].split("&");
            parent_bone_name = expression_01[0];
            child_bone_names = expression_01.slice(1);
            additional_child_bone_names = add_bone_expression.split(">>").slice(1);
            // check if bone already exists
            for (var j = 0; j < aBoneList.length; j++) {
                if (aBoneList[j].name == new_bone_name) {
                    bone_exists = true;
                    break;
                }
            }
            if (bone_exists) {
                print("bone_converter_aArgs.dsa: addNewBones(): Bone already exists: " + new_bone_name + ", skipping.");
                continue;
            }
            // find parent and child bones
            for (var i = 0; i < aBoneList.length; i++) {
                bone = aBoneList[i];
                if (bone.name == parent_bone_name) {
                    parent_bone = bone;
                }
                else {
                    // iterate through child_bone_names
                    for (var k = 0; k < child_bone_names.length; k++) {
                        if (bone.name == child_bone_names[k]) {
                            child_bones.push(bone);
                            break;
                        }
                    }
                    for (var m = 0; m < additional_child_bone_names.length; m++) {
                        if (bone.name == additional_child_bone_names[m]) {
                            additional_child_bones.push(bone);
                            break;
                        }
                    }
                }
                if (parent_bone && child_bones.length == child_bone_names.length &&
                    additional_child_bones.length == additional_child_bone_names.length) {
                    break;
                }
            }
            if (parent_bone) {
                // new bone position is average of parent and child(ren)
                var new_bone_pos = parent_bone.getWSPos();
                if (child_bones.length > 0) {
                    var avg_child_pos = new DzVec3(0,0,0);
                    for (var j = 0; j < child_bones.length; j++) {
                        avg_child_pos = avg_child_pos.add(child_bones[j].getWSPos());
                    }
                    avg_child_pos = avg_child_pos.divide(DzVec3(child_bones.length, child_bones.length, child_bones.length));
                    new_bone_pos = new_bone_pos.add(avg_child_pos).multiply(DzVec3(0.5, 0.5, 0.5));
                }
                // create new bone
                new_bone = parent_bone.duplicate(false);
                new_bone.setName(new_bone_name);
                new_bone.setLabel(new_bone_name);
                new_bone.setOrigin(new_bone_pos, /*makeDefault*/ true);
                new_bone.setWSPos(new_bone_pos);
                // reparent child bones to new bone
                for (var k = 0; k < child_bones.length; k++) {
                    new_bone.addNodeChild(child_bones[k], /*inPlace*/ true)
                }
                for (var m = 0; m < additional_child_bones.length; m++) {
                    new_bone.addNodeChild(additional_child_bones[m], /*inPlace*/ true)
                }
                // parent new bone to parent bone
                parent_bone.addNodeChild(new_bone, /*inPlace*/ true);
                aBonesAdded.push(new_bone);
                print("bone_converter_aArgs.dsa: addNewBones(): Added new bone: " + new_bone_name + ", parent: " + parent_bone_name + ", children: " + child_bone_names.join(", "));                
            }
            else {
                print("bone_converter_aArgs.dsa: addNewBones(): ERROR: Could not find parent for new bone: " + new_bone_name + ", skipping.");
                continue;
            }
        }
    }
}

// Validates if the selected figure is compatible.
function isValidFigure(figure) {
    // Implement validation logic here, possibly checking figure's type or name.
    if (figure.inherits("DzFigure") == false) return false;
    var sGeneration = figure.getName();
    var bIsG9 = (sGeneration == "Genesis9");
    var bIsG8 = (sGeneration.indexOf("Genesis8") == 0);
    var bIsG3 = (sGeneration.indexOf("Genesis3") == 0);
    var bIsG2 = (sGeneration.indexOf("Genesis2") == 0);
    var bIsG1 = (sGeneration == "Genesis");

    if (bIsG9 || bIsG8 || bIsG3 || bIsG2 || bIsG1) {
        return true;
    }

    return false; // Placeholder for validation logic
}

// Main script execution function.
function main() {
    print("bone_converter3: Starting script...");

    var selectedFigure = Scene.getPrimarySelection(); // Assuming getSelectedNode() retrieves the currently selected figure.
    if (!selectedFigure || !isValidFigure(selectedFigure)) {
        var sFigureName = "Invalid Object";
        if (selectedFigure) sFigureName = selectedFigure.getName();
        var sMesg = "ERROR: bone_converter3: Invalid figure selected: " + sFigureName + ", aborting script.";
        App.log(sMesg);
        // MessageBox.information("Please select a valid Genesis 8 or 9 figure.", "Invalid selection", "OK");
        throw new Error(sMesg);
    }

    if (!processArguments()) {
        var sMesg = "bone_converter_aArgs.dsa: Failed to process arguments, aborting script, see Log for details.";
        App.log(sMesg);
        print(sMesg);
        throw new Error(sMesg);
    }

    var mapping = {};
    for (var i = 0; i < aBoneMapFiles.length; i++) {
        mapping = loadMappingTable(aBoneMapFiles[i], mapping);
    }

    // Sanity Check, make sure all bones exist and will not be deleted
    var aBoneList = getBones(selectedFigure); // Assuming getBones() retrieves all bones of the figure
    var numKeys = Object.keys(mapping).length;
    var bonesMatchingKeys = 0;
    var bonesMatchingVals = 0;
    for (var key in mapping) {
        for (var i = 0; i < aBoneList.length; i++) {
            if (aBoneList[i].name == key) {
                bonesMatchingKeys++;
            }
            if (aBoneList[i].name == mapping[key]) {
                bonesMatchingVals++;
            }
        }
    }
    if ( bonesMatchingVals == numKeys) {
        var sMesg = "bone_converter_aArgs.dsa: ERROR: Bones appear to already be converted. EXITING!";
        App.log(sMesg);
        print(sMesg);
        throw new Error(sMesg);
    }
    if ( bonesMatchingKeys == 0) {
        var sMesg = "bone_converter_aArgs.dsa: CRITICAL ERROR: No bones were found in the figure. EXITING!";
        App.log(sMesg);
        print(sMesg);
        throw new Error(sMesg);
    }
    if (bonesMatchingKeys < numKeys) {
        var sMesg = "bone_converter_aArgs.dsa: WARNING: Not all bones were found in the figure. PROCEEDING ANYWAY...";
        App.log(sMesg);
        print(sMesg);
    }

    addNewBones(selectedFigure);
    renameBones(selectedFigure, mapping);
    deleteMarkedBones();

	Scene.setPrimarySelection(selectedFigure);

    //MessageBox.information("Bone renaming process completed successfully.", "Script complete", "OK");
    App.log("bone_converter_aArgs.dsa: Bone renaming process completed successfully.");
    print("bone_converter_aArgs.dsa: Bone renaming process completed successfully.");

    return true;
}

// Loads the bone mapping table.
function loadMappingTable(sMapFile, mapping) {
    if (mapping != null) {
        var boneMapping = mapping;
    } else {
        var boneMapping = {};
    }
    
    var file = new DzFile(sMapFile);
    if (file.open(DzFile.ReadOnly)) {
        var jsonString = file.read();
        file.close();
        var fileMapping = JSON.parse(jsonString);

        for (var key in fileMapping) {
            if (fileMapping.hasOwnProperty(key)) {
                if (key.startsWith("++")) {
                    var key_expression = key.substring(2);
                    var new_bone_name = fileMapping[key];
                    oBonesToAddMapping[new_bone_name] = key_expression;
                } else {
                    boneMapping[key] = fileMapping[key];
                }
            }
        }
    }
    else {
        App.log("bone_converter_aArgs.dsa: loadMappingTable(): Failed to open file: " + sMapFile);
    }

    return boneMapping;
}

// Run the main function
return main();

})( getArguments() );
